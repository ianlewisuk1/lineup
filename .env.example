# ============================================================
# Frontend (React) — prefix with REACT_APP_
# Copy to .env and fill in values from your Supabase project dashboard
# Settings > API > Project URL and anon/public key
# ============================================================
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key-here

# ============================================================
# Backend (Node.js cron service)
# service_role key is in Settings > API — keep this secret, never expose to frontend
# ============================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# College Football Data API key (https://collegefootballdata.com)
CFB_KEY=your-cfbd-api-key-here

# Port for the backend Express server
PORT=3001
